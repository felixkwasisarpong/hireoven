# Hireoven harvester worker — long-running tick loop, separate Coolify service.
# No Next.js build needed; tsx interprets TypeScript at runtime.

FROM node:20-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs nodeapp

COPY package.json package-lock.json ./
RUN npm ci

# Worker only imports from lib/ + types/. tsconfig provides the @/* path alias.
COPY tsconfig.json ./
COPY next-env.d.ts ./
COPY lib ./lib
COPY scripts ./scripts
COPY types ./types

USER nodeapp
ENV NODE_ENV=production

CMD ["npm", "run", "harvester:worker"]
