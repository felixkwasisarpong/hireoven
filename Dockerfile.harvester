# Hireoven harvester worker — long-running tick loop, separate Coolify service.
# No Next.js build needed; tsx interprets TypeScript at runtime.

FROM node:20-bookworm-slim
WORKDIR /app

# `ca-certificates` for HTTPS; the rest are Chromium runtime deps so the
# Playwright-driven Apple adapter (and any future JS-rendered scraper) has
# a working headless browser. List mirrors Playwright's `--with-deps install`
# for chromium on Debian 12.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      fonts-liberation \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libatspi2.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libwayland-client0 \
      libx11-6 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      xdg-utils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs nodeapp

# Install Chromium into a shared system path that the `nodeapp` user can read.
# By default Playwright writes to $HOME/.cache/ms-playwright — `nodeapp` has no
# writable home in this image, so set PLAYWRIGHT_BROWSERS_PATH globally and
# install during build (as root) so the binary lives at a known, world-readable
# location at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
RUN npm ci

# Only Chromium (Playwright supports Firefox/WebKit too — skipping them keeps
# the layer ~280MB instead of ~900MB).
RUN mkdir -p $PLAYWRIGHT_BROWSERS_PATH \
    && npx -y playwright install chromium \
    && chmod -R go+rX $PLAYWRIGHT_BROWSERS_PATH

# Worker imports from lib/ + scripts/ only. `@/types` references in the
# transitive import chain are all `import type {...}` — tsconfig has
# `isolatedModules: true` so tsx/esbuild strip them. The top-level types/
# directory is not needed at runtime.
COPY tsconfig.json ./
COPY next-env.d.ts ./
COPY lib ./lib
COPY scripts ./scripts

USER nodeapp
ENV NODE_ENV=production

CMD ["npm", "run", "harvester:worker"]


