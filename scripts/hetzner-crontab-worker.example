# Hireoven cron entries — for the HARVESTER box (havester, 8 GB, us-west).
#
# All heavy batch work runs HERE, against a private app-worker container on this
# same box (http://localhost:3100 — the `app-worker` service in
# docker-compose.prod.yml, started with `docker compose --profile worker up -d`).
# Because APP_URL points at localhost, the crawl/enrichment/ingest CPU+RAM stay
# on this box and never touch the user-facing 4 GB web box (which only serves the
# site + Postgres + MinIO). That's what stops the 502s.
#
# Setup (one-time):
#   1. On the harvester box, bring up the worker:
#        docker compose --profile worker up -d app-worker
#      (set DATABASE_URL + MINIO_ENDPOINT in .env to the web box host first.)
#   2. crontab -e  →  paste the contents below  →  save.  Confirm: crontab -l
#   3. sudo mkdir -p /var/log/hireoven && sudo chown $USER:$USER /var/log/hireoven
#
# Logs: /var/log/hireoven/<task>.log

# ── Environment (crontab requires explicit env — it doesn't source ~/.bashrc) ──
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HIREOVEN_REPO=/opt/hireoven
# Local private worker on THIS box — not the public site.
APP_URL=http://localhost:3100
CRON_SECRET=REPLACE_ME
# Needed only by the npm capture task below (runs via tsx on the host, not the
# worker container). Point at the web box Postgres, same as the harvester.
DATABASE_URL=REPLACE_ME

# ── Schedules ───────────────────────────────────────────────────────────────────
# m h dom mon dow  command
 */30 * * * *     cd $HIREOVEN_REPO && bash scripts/crons.sh recent-jobs        >>/var/log/hireoven/recent-jobs.log 2>&1
 20 * * * *        flock -n /tmp/hireoven-crawl.lock -c 'cd $HIREOVEN_REPO && timeout 55m bash scripts/crons.sh crawl >>/var/log/hireoven/crawl.log 2>&1'
# Cross-sector capture sweep (runs via tsx on the host — uses DATABASE_URL above).
 20 1 * * *        cd $HIREOVEN_REPO && npm run capture:companies:continuous:execute -- --states-per-run=4 --state-limit=36 --state-min-certified=8 >>/var/log/hireoven/capture-companies-continuous.log 2>&1
# Recommended deep sweep lane for crawler-only territory (off-peak):
 45 2 * * *      flock -n /tmp/hireoven-crawl.lock -c 'cd $HIREOVEN_REPO && CRAWLER_MAX_COMPANIES_PER_RUN=300 CRAWLER_COMPANY_CONCURRENCY=4 timeout 90m bash scripts/crons.sh crawl-full-non-ats >>/var/log/hireoven/crawl-full-non-ats.log 2>&1'
# Description enrichment — now near-empty (auto-retire keeps the pending floor at
# zero), but keep it running to publish fresh crawler jobs within ~5 min.
 */5 * * * *       flock -n /tmp/hireoven-enrich.lock -c 'cd $HIREOVEN_REPO && JOB_DESCRIPTION_ENRICHMENT_BATCH=500 JOB_DESCRIPTION_ENRICHMENT_CONCURRENCY=12 bash scripts/crons.sh job-description-enrichment >>/var/log/hireoven/job-description-enrichment.log 2>&1'
  0 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh ghost-scan         >>/var/log/hireoven/ghost-scan.log 2>&1
  0 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh timing-refresh     >>/var/log/hireoven/timing-refresh.log 2>&1
  0 */4 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh cohort-detect      >>/var/log/hireoven/cohort-detect.log 2>&1
  0 */12 * * *     cd $HIREOVEN_REPO && bash scripts/crons.sh cohort-match       >>/var/log/hireoven/cohort-match.log 2>&1
  0 1 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh layoffs-fyi        >>/var/log/hireoven/layoffs-fyi.log 2>&1
  0 2 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh health-scores      >>/var/log/hireoven/health-scores.log 2>&1
  0 3 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh rejection-patterns >>/var/log/hireoven/rejection-patterns.log 2>&1
  0 4 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh burnout-classify   >>/var/log/hireoven/burnout-classify.log 2>&1
  0 5 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh salary-digest      >>/var/log/hireoven/salary-digest.log 2>&1
  0 6 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh warn-act           >>/var/log/hireoven/warn-act.log 2>&1
  0 7 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh cohort-aggregate   >>/var/log/hireoven/cohort-aggregate.log 2>&1
  0 9 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh deliver-checkins   >>/var/log/hireoven/deliver-checkins.log 2>&1
 30 0 * * *        cd $HIREOVEN_REPO && JOB_RETENTION_DAYS=30 JOB_RETENTION_BATCH=5000 JOB_RETENTION_MAX_BATCHES=50 bash scripts/crons.sh job-retention >>/var/log/hireoven/job-retention.log 2>&1
 15 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh waas-ingest        >>/var/log/hireoven/waas-ingest.log 2>&1
 30 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh adzuna-ingest      >>/var/log/hireoven/adzuna-ingest.log 2>&1
 45 5 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh jsearch-ingest     >>/var/log/hireoven/jsearch-ingest.log 2>&1
  0 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh dice-ingest        >>/var/log/hireoven/dice-ingest.log 2>&1
  0 4 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh discover-companies >>/var/log/hireoven/discover-companies.log 2>&1
  0 */2 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh discover-tenants   >>/var/log/hireoven/discover-tenants.log 2>&1
  0 */4 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh builtin-discovery  >>/var/log/hireoven/builtin-discovery.log 2>&1
 30 */4 * * *      cd $HIREOVEN_REPO && CAREERS_DISCOVERY_BATCH=10 bash scripts/crons.sh careers-url-discovery >>/var/log/hireoven/careers-url-discovery.log 2>&1
# ── Off-box enumeration (host-side tsx, like the capture task above — uses DATABASE_URL, NOT a 300s route) ──
# Common Crawl mines path-based ATS boards (Greenhouse/Ashby/Workable/SmartRecruiters/Rippling) that crt.sh
# structurally can't see. Heavy CDX parse → runs on the host, weekly. Size it first: drop EXECUTE=true for a dry run.
  0 3 * * 1        flock -n /tmp/hireoven-ccmine.lock -c 'cd $HIREOVEN_REPO && EXECUTE=true bash scripts/run-discovery-mining.sh >>/var/log/hireoven/commoncrawl-mine.log 2>&1'
# Workday backlog drain — resolves the {tenant}:{wd}:unresolved stubs discover-companies parks (it only does 20/run).
# Size the backlog first: drop --apply for a dry run.
  0 */6 * * *      flock -n /tmp/hireoven-wddrain.lock -c 'cd $HIREOVEN_REPO && npx tsx scripts/drain-workday-candidates.ts --apply --limit=500 >>/var/log/hireoven/drain-workday.log 2>&1'
# ── Recover the name-only stub pool: name -> real domain (the missing first step) ──
# Resolves Adzuna/Dice placeholder companies that have active jobs (~57% hit rate),
# turning name-only stubs into real-domain rows that the EXISTING discover-from-domains
# cron (06:00) then resolves to an ATS / careers crawl. Runs at 02:00 so resolved domains
# are ready before that 06:00 consumer. Dry-run: add --dry-run.
# NOTE: discover-from-domains is a NO-OP unless DISCOVER_FROM_DOMAINS_ENABLED=true is set in
# the app-worker .env — verify that flag, or step 2 never fires.
  0 2 * * *        flock -n /tmp/hireoven-domresolve.lock -c 'cd $HIREOVEN_REPO && timeout 60m npx tsx scripts/enrich-placeholder-company-domains.ts --limit=5000 --concurrency=12 >>/var/log/hireoven/enrich-domains.log 2>&1'
  0 6 * * *        flock -n /tmp/hireoven-domain-ats.lock -c 'cd $HIREOVEN_REPO && DISCOVER_FROM_DOMAINS_BATCH=800 DISCOVER_FROM_DOMAINS_CONCURRENCY=12 DISCOVER_FROM_DOMAINS_PROMOTE_CUSTOM=true timeout 75m bash scripts/crons.sh discover-from-domains >>/var/log/hireoven/discover-from-domains.log 2>&1'
