# Hireoven cron entries — for the HARVESTER box (havester, 8 GB, us-west).
#
# All heavy batch work runs HERE, against a private app-worker container on this
# same box (http://localhost:3100 — the `app-worker` service in
# docker-compose.prod.yml, started with `docker compose --profile worker up -d`).
# Because APP_URL points at localhost, the crawl/enrichment/ingest CPU+RAM stay
# on this box and never touch the user-facing 4 GB web box (which only serves the
# site + Postgres + MinIO). That's what stops the 502s.
#
# Setup (one-time):
#   1. On the harvester box, bring up the worker:
#        docker compose --profile worker up -d app-worker
#      (set DATABASE_URL + MINIO_ENDPOINT in .env to the web box host first.)
#   2. crontab -e  →  paste the contents below  →  save.  Confirm: crontab -l
#   3. sudo mkdir -p /var/log/hireoven && sudo chown $USER:$USER /var/log/hireoven
#
# Logs: /var/log/hireoven/<task>.log

# ── Environment (crontab requires explicit env — it doesn't source ~/.bashrc) ──
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HIREOVEN_REPO=/opt/hireoven
# Local private worker on THIS box — not the public site.
APP_URL=http://localhost:3100
CRON_SECRET=REPLACE_ME
# Needed only by the npm capture task below (runs via tsx on the host, not the
# worker container). Point at the web box Postgres, same as the harvester.
DATABASE_URL=REPLACE_ME

# ── Schedules ───────────────────────────────────────────────────────────────────
# m h dom mon dow  command
 */30 * * * *     cd $HIREOVEN_REPO && bash scripts/crons.sh recent-jobs        >>/var/log/hireoven/recent-jobs.log 2>&1
 */5 * * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh instant-notify     >>/var/log/hireoven/instant-notify.log 2>&1
 * * * * *         cd $HIREOVEN_REPO && bash scripts/crons.sh signal-api-webhooks >>/var/log/hireoven/signal-api-webhooks.log 2>&1
 20 * * * *        flock -n /tmp/hireoven-crawl.lock -c 'cd $HIREOVEN_REPO && timeout 55m bash scripts/crons.sh crawl >>/var/log/hireoven/crawl.log 2>&1'
# Cross-sector capture sweep (runs via tsx on the host — uses DATABASE_URL above).
# RAMP (200k/day): drain the 48k unmatched LCA sponsors faster — more states/run, higher cap, lower min.
 20 1,13 * * *     cd $HIREOVEN_REPO && npm run capture:companies:continuous:execute -- --states-per-run=8 --state-limit=60 --state-min-certified=5 >>/var/log/hireoven/capture-companies-continuous.log 2>&1
# Recommended deep sweep lane for crawler-only territory (off-peak):
 45 2 * * *      flock -n /tmp/hireoven-crawl.lock -c 'cd $HIREOVEN_REPO && timeout 90m bash scripts/crons.sh crawl-full-non-ats >>/var/log/hireoven/crawl-full-non-ats.log 2>&1'
# Description enrichment — drains pending_enrichment (incl. Adzuna recovery, which
# needs the Playwright fallback). `timeout -k 10 280` bounds the run under the 5-min
# interval so a wedged browser render can never hold the flock and freeze the queue;
# batch=120 keeps a single bounded run from over-claiming jobs into `processing`.
 */5 * * * *       flock -n /tmp/hireoven-enrich.lock -c 'cd $HIREOVEN_REPO && JOB_DESCRIPTION_ENRICHMENT_BATCH=120 JOB_DESCRIPTION_ENRICHMENT_CONCURRENCY=12 timeout -k 10 280 bash scripts/crons.sh job-description-enrichment >>/var/log/hireoven/job-description-enrichment.log 2>&1'
  0 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh ghost-scan         >>/var/log/hireoven/ghost-scan.log 2>&1
  5 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh timing-refresh     >>/var/log/hireoven/timing-refresh.log 2>&1
 10 */6 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh cohort-refresh     >>/var/log/hireoven/cohort-refresh.log 2>&1
  0 1 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh layoffs-fyi        >>/var/log/hireoven/layoffs-fyi.log 2>&1
  0 2 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh health-scores      >>/var/log/hireoven/health-scores.log 2>&1
  0 3 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh rejection-patterns >>/var/log/hireoven/rejection-patterns.log 2>&1
  0 4 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh burnout-classify   >>/var/log/hireoven/burnout-classify.log 2>&1
  0 5 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh salary-digest      >>/var/log/hireoven/salary-digest.log 2>&1
  0 6 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh warn-act           >>/var/log/hireoven/warn-act.log 2>&1
  0 8 * * 1-5      cd $HIREOVEN_REPO && bash scripts/crons.sh blog-generate      >>/var/log/hireoven/blog-generate.log 2>&1
  0 9 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh deliver-checkins   >>/var/log/hireoven/deliver-checkins.log 2>&1
# ── Spec 08 email engine (host-side tsx; reuses the RESEND_* env already set here) ──
# Reads env from the repo .env via loadEnvConfig. Snapshot must run for ≥2 weeks
# before the weekly digest shows real movers. Webhook stays on the web box.
 40 5 * * *        flock -n /tmp/hireoven-email-snapshot.lock -c 'cd $HIREOVEN_REPO && npm run email:snapshot-ranks:execute >>/var/log/hireoven/email-snapshot.log 2>&1'
 5 * * * *         flock -n /tmp/hireoven-email-weekly.lock   -c 'cd $HIREOVEN_REPO && npm run email:weekly:execute        >>/var/log/hireoven/email-weekly.log 2>&1'
 5,20,35,50 * * * * flock -n /tmp/hireoven-email-layoff.lock  -c 'cd $HIREOVEN_REPO && npm run email:layoff-alerts:execute >>/var/log/hireoven/email-layoffs.log 2>&1'
 15 9 * * *        flock -n /tmp/hireoven-email-milestone.lock -c 'cd $HIREOVEN_REPO && npm run email:milestones:execute   >>/var/log/hireoven/email-milestones.log 2>&1'
 20 9 * * *        flock -n /tmp/hireoven-email-opt.lock      -c 'cd $HIREOVEN_REPO && npm run email:opt-reminders:execute >>/var/log/hireoven/email-opt.log 2>&1'
 13,43 * * * *     flock -n /tmp/hireoven-email-health.lock   -c 'cd $HIREOVEN_REPO && npm run email:queue-health:execute  >>/var/log/hireoven/email-health.log 2>&1'
 30 8 * * *        flock -n /tmp/hireoven-maintenance.lock -c 'cd $HIREOVEN_REPO && JOB_RETENTION_DAYS=30 JOB_RETENTION_BATCH=5000 JOB_RETENTION_MAX_BATCHES=50 bash scripts/crons.sh nightly-maintenance >>/var/log/hireoven/nightly-maintenance.log 2>&1'
# Dead-board self-clean: harvestable companies we crawl every cycle for nothing
# (>=20 consecutive empty crawls, zero active jobs, nothing seen in 30 days) ->
# status='dead' so the harvester stops claiming them (reversible; visa sponsors
# preserved). Runs at 08:45, right after nightly-maintenance deletes their stale
# jobs (so freshly job-less companies are caught the same morning).
 45 8 * * *        flock -n /tmp/hireoven-purge-dead.lock -c 'cd $HIREOVEN_REPO && PURGE_DEAD_MIN_EMPTY_CRAWLS=20 PURGE_DEAD_MODE=dead bash scripts/crons.sh purge-dead-crawled-companies >>/var/log/hireoven/purge-dead-crawled.log 2>&1'
# Fresh job-board feeds: WAAS + Dice + Adzuna. JSearch stays separate because its API budget is daily.
 15 */6 * * *      flock -n /tmp/hireoven-fresh-ingest.lock -c 'cd $HIREOVEN_REPO && timeout 45m bash scripts/crons.sh fresh-job-ingest >>/var/log/hireoven/fresh-job-ingest.log 2>&1'
 45 5 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh jsearch-ingest     >>/var/log/hireoven/jsearch-ingest.log 2>&1
# Aggregator feeds via the shared ingest pipeline (lib/jobs/aggregator-ingest).
# Keyless: remotive, themuse, remoteok, arbeitnow. Keyed: careerjet (CAREERJET_AFFILIATE_ID), jooble (JOOBLE_API_KEY).
  0 */12 * * *     flock -n /tmp/hireoven-aggregator-ingest.lock -c 'cd $HIREOVEN_REPO && timeout 75m bash scripts/crons.sh aggregator-job-ingest >>/var/log/hireoven/aggregator-job-ingest.log 2>&1'
  0 4 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh discover-companies >>/var/log/hireoven/discover-companies.log 2>&1
  0 */2 * * *      cd $HIREOVEN_REPO && bash scripts/crons.sh discover-tenants   >>/var/log/hireoven/discover-tenants.log 2>&1
# Company-first ATS sweep — probes the ~39k weak/unmatched companies against the
# platforms (eightfold, greenhouse, lever, ashby, smartrecruiters) and enrols any
# with a live board. Rotates via ats_sweep_at. CRON_MAX_TIME guards a hung probe.
 */20 * * * *      flock -n /tmp/hireoven-ats-sweep.lock -c 'cd $HIREOVEN_REPO && CRON_MAX_TIME=290 bash scripts/crons.sh discover-ats-sweep >>/var/log/hireoven/discover-ats-sweep.log 2>&1'
 30 */4 * * *      flock -n /tmp/hireoven-ats-discovery.lock -c 'cd $HIREOVEN_REPO && CAREERS_DISCOVERY_BATCH=10 bash scripts/crons.sh ats-discovery-sweep >>/var/log/hireoven/ats-discovery-sweep.log 2>&1'
 30 5 * * *        cd $HIREOVEN_REPO && bash scripts/crons.sh glassdoor-discovery >>/var/log/hireoven/glassdoor-discovery.log 2>&1
# ── Off-box enumeration (host-side tsx, like the capture task above — uses DATABASE_URL, NOT a 300s route) ──
# Common Crawl mines path-based ATS boards (Greenhouse/Ashby/Workable/SmartRecruiters/Rippling) that crt.sh
# structurally can't see. Heavy CDX parse → runs on the host, weekly. Size it first: drop EXECUTE=true for a dry run.
# RAMP (200k/day): weekly -> DAILY. This is the #1 ATS-company source (~2.3k/run); idle 6 days/week was the biggest throttle. Watch host CPU/RAM + CC egress cost.
  0 3 * * *        flock -n /tmp/hireoven-ccmine.lock -c 'cd $HIREOVEN_REPO && EXECUTE=true bash scripts/run-discovery-mining.sh >>/var/log/hireoven/commoncrawl-mine.log 2>&1'
# Workday backlog drain — resolves the {tenant}:{wd}:unresolved stubs discover-companies parks (it only does 20/run).
# Size the backlog first: drop --apply for a dry run.
  0 */6 * * *      flock -n /tmp/hireoven-wddrain.lock -c 'cd $HIREOVEN_REPO && npx tsx scripts/drain-workday-candidates.ts --apply --limit=500 >>/var/log/hireoven/drain-workday.log 2>&1'
# ── Recover the name-only stub pool: name -> real domain (the missing first step) ──
# Resolves Adzuna/Dice placeholder companies that have active jobs (~57% hit rate),
# turning name-only stubs into real-domain rows that the EXISTING discover-from-domains
# cron (06:00) then resolves to an ATS / careers crawl. Runs at 02:00 so resolved domains
# are ready before that 06:00 consumer. Dry-run: add --dry-run.
# NOTE: discover-from-domains is a NO-OP unless DISCOVER_FROM_DOMAINS_ENABLED=true is set in
# the app-worker .env — verify that flag, or step 2 never fires.
# RAMP (200k/day): 2x/day, bigger batch — feeds domains for the 25.7k placeholder companies so discover-from-domains can make them crawlable.
  0 2,14 * * *     flock -n /tmp/hireoven-domresolve.lock -c 'cd $HIREOVEN_REPO && timeout 60m npx tsx scripts/enrich-placeholder-company-domains.ts --limit=10000 --concurrency=12 >>/var/log/hireoven/enrich-domains.log 2>&1'
# RAMP (200k/day): 2x/day, batch 800->2000. Turns resolved domains into crawlable ATS rows.
# REQUIRES `DISCOVER_FROM_DOMAINS_ENABLED=true` in the app-worker .env — without it this is a NO-OP and the 25.7k placeholders never become crawlable.
  0 6,18 * * *     flock -n /tmp/hireoven-domain-ats.lock -c 'cd $HIREOVEN_REPO && DISCOVER_FROM_DOMAINS_BATCH=2000 DISCOVER_FROM_DOMAINS_CONCURRENCY=12 timeout 75m bash scripts/crons.sh discover-from-domains >>/var/log/hireoven/discover-from-domains.log 2>&1'
# ── New discovery feeders (host-side tsx, like the tasks above) ──
# HN "Who is hiring?" — monthly thread, but cheap to run daily (it no-ops between
# threads). Enrolls ATS-matched apply URLs via enroll-from-apply-url.
 30 7 * * *        flock -n /tmp/hireoven-hn.lock -c 'cd $HIREOVEN_REPO && npm run discover:hn:execute >>/var/log/hireoven/discover-hn.log 2>&1'
# VC portfolios — funded startups are nearly all Greenhouse/Lever/Ashby. Weekly.
  0 4 * * 2        flock -n /tmp/hireoven-vc.lock -c 'cd $HIREOVEN_REPO && timeout 60m npm run discover:vc-portfolios:execute >>/var/log/hireoven/discover-vc.log 2>&1'
# BuiltWith — PAID (Lists API gates to ~$495/mo Pro). Left OFF by default. The
# free path is ad-hoc with a domain list file:
#   npx tsx scripts/discover-builtwith.ts --file=domains.txt --execute
# To enable the recurring per-tech pull, set BUILTWITH_API_KEY and uncomment:
#  0 4 * * 3        flock -n /tmp/hireoven-bw.lock -c 'cd $HIREOVEN_REPO && timeout 90m npx tsx scripts/discover-builtwith.ts --tech=Greenhouse --execute --limit=2000 >>/var/log/hireoven/discover-builtwith.log 2>&1'
# Crunchbase — PAID (no free API tier as of 2025). Left OFF by default. Set
# CRUNCHBASE_API_KEY and uncomment to enable:
#  0 4 * * 4        flock -n /tmp/hireoven-cb.lock -c 'cd $HIREOVEN_REPO && timeout 60m npm run discover:crunchbase:execute >>/var/log/hireoven/discover-crunchbase.log 2>&1'
# ── E-Verify enrichment (host-side tsx + headless Chromium) ──────────────────────
# Drives the USCIS E-Verify search tool one company at a time (no public API/bulk
# download) to flip companies.is_e_verify for top H1B sponsors — powers
# /h1b-sponsors/e-verify. Conservative: exact normalized-name match, "Open" status
# only (a false flag can harm a STEM OPT case). Skips already-flagged companies, so
# each run shrinks. E-Verify enrollment changes slowly → MONTHLY is plenty.
#
# Kept gentle on the box (this is the only headless-browser cron here):
#   - single browser, sequential queries (one Chromium, ~0.5-1 GB peak)
#   - nice -n 19 + ionice -c3  → lowest CPU/IO priority; yields to crawl/ingest/enrich
#   - timeout 10h + flock       → bounded; never overlaps a prior slow run
#   - off-peak (03:30, 1st of month)
# One-time setup on this box:  npx playwright install --with-deps chromium
 30 3 1 * *        flock -n /tmp/hireoven-everify.lock -c 'cd $HIREOVEN_REPO && timeout 10h nice -n 19 ionice -c3 npm run everify:enrich:apply -- --limit=5000 >>/var/log/hireoven/everify-enrich.log 2>&1'
# ── Nightly ATS adapter regression gate (host-side tsx; jobhive-ts differential harness) ──
# Runs the replica vs the harvester's OWN adapters against live boards and exits
# non-zero on a *systemic* divergence — an adapter silently returning ~0 vs the
# replica (the teamtailor/workday/oracle "empty board" bug class). Runs HERE, not
# GitHub Actions, so workday/workable egress through the harvester's residential
# proxy (read live from the running harvester container via `docker exec printenv`).
# On failure it touches /var/log/hireoven/ats-regression-gate.FAILED (cleared on a
# pass) so monitoring can alert. Needs the harness on this box — keep /opt/hireoven
# `git pull`ed (the gate runs whatever tools/jobhive-ts is checked out).
 50 7 * * *        flock -n /tmp/hireoven-ats-gate.lock -c 'cd $HIREOVEN_REPO && C=$(docker ps --filter name=harvester --format "{{.Names}}" | head -1) && HARVESTER_PROXY_URL="$(docker exec $C printenv HARVESTER_PROXY_URL 2>/dev/null)" HARVESTER_PROXY_HOSTS="$(docker exec $C printenv HARVESTER_PROXY_HOSTS 2>/dev/null)" timeout 300 node_modules/.bin/tsx tools/jobhive-ts/benchmark.ts --ats greenhouse,lever,ashby,smartrecruiters,workable,workday,recruitee,teamtailor,personio,bamboohr,oraclecloud --per-ats 4 --timeout 120000 --shared-transport --gate >>/var/log/hireoven/ats-regression-gate.log 2>&1 && rm -f /var/log/hireoven/ats-regression-gate.FAILED || touch /var/log/hireoven/ats-regression-gate.FAILED'
